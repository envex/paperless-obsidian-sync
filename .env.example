PAPERLESS_URL=http://your-paperless-host:8777
PAPERLESS_TOKEN=your_token_here

COUCHDB_URL=http://your-couchdb-host
COUCHDB_DB=obsidian
COUCHDB_USER=your_user
COUCHDB_PASSWORD=your_password

SYNC_INTERVAL_MINUTES=60
PORT=3000

# Optional: comma-separated list of tag names to sync (empty = sync all)
SYNC_TAGS=

# Optional: enable AI OCR cleanup via Claude Haiku
ANTHROPIC_API_KEY=
